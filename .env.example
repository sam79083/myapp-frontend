# Browser-safe (exposed to the client) — these are REQUIRED.
# Get them from Supabase dashboard → Project Settings → API.
# Use the PUBLISHABLE key (sb_publishable_...) for NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://sgkfmmemqgbvvwrpxeix.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

